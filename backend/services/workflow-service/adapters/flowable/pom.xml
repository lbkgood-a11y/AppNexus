<?xml version="1.0" encoding="UTF-8"?>
<!-- workflow-flowable-adapter：职责与依赖边界见同目录 README 或工作流服务详细设计。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.appnexus</groupId><artifactId>workflow-adapters</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../pom.xml</relativePath></parent>
  <artifactId>workflow-flowable-adapter</artifactId>

  <dependencies>
    <!-- 单据服务仅通过公开契约集成，业务执行仍归业务模块。 -->
    <dependency><groupId>com.appnexus</groupId><artifactId>document-contracts</artifactId><version>${project.version}</version></dependency>
    <!-- 引擎装配必须等待受控数据库迁移，不能抢先访问未建表的数据源。 -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-sql</artifactId></dependency>
    <!-- 工作流应用适配提供真实 HTTP 与 JDBC 持久化；认证复用组合应用的安全链。 -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-jdbc</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency>
      <groupId>com.appnexus</groupId><artifactId>workflow-core</artifactId><version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- 锁定内嵌引擎版本为 8.0.0；升级须重新验证 MySQL 表版本及 Spring 事务兼容性。 -->
    <dependency>
      <groupId>org.flowable</groupId><artifactId>flowable-spring</artifactId><version>8.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId><artifactId>testcontainers-mysql</artifactId><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope>
    </dependency>
    <!-- MySQL 驱动仅用于真实数据库集成测试；运行时驱动由组合应用提供。 -->
    <dependency>
      <groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>test</scope>
    </dependency>
  </dependencies>
</project>
