<?xml version="1.0" encoding="UTF-8"?>
<!-- approval-flowable-adapter：职责与依赖边界见同目录 README 或审批服务详细设计。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.appnexus</groupId><artifactId>approval-adapters</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../pom.xml</relativePath></parent>
  <artifactId>approval-flowable-adapter</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.appnexus</groupId><artifactId>approval-core</artifactId><version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId>
