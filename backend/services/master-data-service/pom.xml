<?xml version="1.0" encoding="UTF-8"?>
<!-- 主数据独立服务；只依赖平台公开租户和授权契约，由应用组合层装配。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.appnexus</groupId><artifactId>services</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>master-data-service</artifactId>
  <dependencies>
    <!-- 历史Java迁移复用Flyway连接，不改变事务所有权或迁移资源。 -->
    <dependency><groupId>com.appnexus</groupId><artifactId>mybatis-migration</artifactId><version>${project.version}</version></dependency>
    <!-- 沿用全仓MyBatis版本；存储通过宿主SqlSession和Spring事务执行。 -->
    <dependency><groupId>org.mybatis.spring.boot</groupId><artifactId>mybatis-spring-boot-starter</artifactId><version>${mybatis-spring-boot.version}</version></dependency>
    <!-- 固定Mapper的中立范围元数据，不引入平台持久化或其他业务实现。 -->
    <dependency><groupId>com.appnexus</groupId><artifactId>mybatis-scope</artifactId><version>${project.version}</version></dependency>
    <!-- 商品审核集成测试使用公共对象审批桥接；正式主数据不依赖引擎实现。 -->
    <dependency><groupId>com.appnexus</groupId><artifactId>workflow-flowable-adapter</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <!-- 存储集成测试使用生产公共行范围实现；正式业务仅依赖授权公开契约。 -->
    <dependency><groupId>com.appnexus</groupId><artifactId>platform-persistence-adapter</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <!-- 审批仅依赖公开契约，不读取引擎表或引入Flowable实现。 -->
    <dependency><groupId>com.appnexus</groupId><artifactId>workflow-contracts</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.appnexus</groupId><artifactId>business-object-contracts</artifactId><version>${project.version}</version></dependency>
<!-- 字典选项与引用通过配置公开契约读取，禁止跨模块读取字典表。 -->
<dependency><groupId>com.appnexus</groupId><artifactId>platform-configuration</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-json</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>com.appnexus</groupId><artifactId>platform-tenant</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.appnexus</groupId><artifactId>operation-contracts</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-mysql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
