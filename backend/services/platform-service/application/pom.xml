<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.appnexus</groupId>
    <artifactId>platform-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>platform-application</artifactId>
  <dependencies>
    <!-- 请假 POC 业务仅在组合启动装配，通过公开工作流契约访问审批。 -->
    <dependency><groupId>com.appnexus</groupId><artifactId>leave-poc</artifactId><version>${project.version}</version></dependency>
    <!-- 正式契约生成；分组和访问控制在应用装配，不能把所有 Controller 直接发布给外部合作方。 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <version>3.2.0</version>
    </dependency>
    <!-- 组合启动专用依赖；平台领域模块不得引用工作流实现。Flowable 版本在工作流适配器锁定。 -->
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>workflow-flowable-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 组合部署打印服务；服务通过公开平台桥接复核租户与功能权限。 -->
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>print-jdbc-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-identity</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-tenant</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-organization</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-authorization</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-localization</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-configuration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-audit</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-app-api-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-partner-api-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-management-api-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-persistence-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-security-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-eventing-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.appnexus</groupId>
      <artifactId>platform-observability-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
